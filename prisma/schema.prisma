generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CLEARED
  SETTLED
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BillStatus {
  PENDING
  SCHEDULED
  PAID
  OVERDUE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  passwordHash   String?
  currency       String          @default("USD")
  timezone       String          @default("UTC")
  preferredLanguage String       @default("en")
  locale         String          @default("en")
  onboarded      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
  paySchedules   PaySchedule[]
  budgetPlans    BudgetPlan[]
  bills          Bill[]
  goals          Goal[]
  debts          Debt[]
  sessions       Session[]
  deductions     Deduction[]
  rules          Rule[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Account {
  id             String          @id @default(cuid())
  name           String
  type           String
  institution    String?
  balance        Decimal         @default(0) @db.Decimal(18, 2)
  currency       String          @default("USD")
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  transactions   Transaction[]
  recurringRules RecurringRule[]
  bills          Bill[]
  debts          Debt[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Category {
  id             String          @id @default(cuid())
  name           String
  type           CategoryType
  color          String?
  icon           String?
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  transactions   Transaction[]
  budgetItems    BudgetItem[]
  recurringRules RecurringRule[]
  bills          Bill[]
  goals          Goal[]
  splits         TransactionSplit[]
  rules          Rule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, name])
}

model Transaction {
  id              String            @id @default(cuid())
  description     String?
  notes           String?
  amount          Decimal           @db.Decimal(18, 2)
  currency        String            @default("USD")
  postedAt        DateTime
  status          TransactionStatus @default(PENDING)
  accountId       String
  account         Account           @relation(fields: [accountId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id])
  recurringRuleId String?
  recurringRule   RecurringRule?    @relation(fields: [recurringRuleId], references: [id])
  splits          TransactionSplit[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([postedAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([userId, postedAt])
  @@index([userId, categoryId])
}

model TransactionSplit {
  id             String     @id @default(cuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id])
  amount         Decimal    @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([categoryId])
}

model Rule {
  id                  String    @id @default(cuid())
  descriptionContains String
  priority            Int       @default(0)
  active              Boolean   @default(true)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, priority])
  @@index([userId, descriptionContains])
}

model RecurringRule {
  id          String        @id @default(cuid())
  name        String
  cadence     Frequency
  interval    Int           @default(1)
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD")
  startDate   DateTime
  endDate     DateTime?
  dayOfMonth  Int?
  dayOfWeek   Int?
  nextRun     DateTime?
  nextRunAt   DateTime?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  accountId   String?
  account     Account?      @relation(fields: [accountId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  bills       Bill[]
  transactions Transaction[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PaySchedule {
  id          String     @id @default(cuid())
  name        String
  cadence     Frequency
  interval    Int        @default(1)
  anchorDate  DateTime
  nextPayDate DateTime?
  netPay      Decimal    @default(0) @db.Decimal(18, 2)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BudgetPlan {
  id          String        @id @default(cuid())
  name        String
  periodStart DateTime
  periodEnd   DateTime
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  items       BudgetItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BudgetItem {
  id           String     @id @default(cuid())
  amount       Decimal    @db.Decimal(18, 2)
  spent        Decimal    @default(0) @db.Decimal(18, 2)
  budgetPlanId String
  budgetPlan   BudgetPlan @relation(fields: [budgetPlanId], references: [id])
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Bill {
  id              String      @id @default(cuid())
  name            String
  amount          Decimal     @db.Decimal(18, 2)
  currency        String      @default("USD")
  dueDate         DateTime
  frequency       Frequency   @default(MONTHLY)
  status          BillStatus  @default(PENDING)
  autopay         Boolean     @default(false)
  reminderDays    Int         @default(3)
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  accountId       String?
  account         Account?    @relation(fields: [accountId], references: [id])
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(18, 2)
  currentAmount Decimal   @default(0) @db.Decimal(18, 2)
  targetDate    DateTime?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Debt {
  id              String     @id @default(cuid())
  name            String
  principal       Decimal    @db.Decimal(18, 2)
  interestRate    Float
  minimumPayment  Decimal    @db.Decimal(18, 2)
  dueDay          Int?
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  accountId       String?
  account         Account?   @relation(fields: [accountId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Deduction {
  id         String   @id @default(cuid())
  name       String
  amount     Decimal  @db.Decimal(18, 2)
  isPercent  Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
